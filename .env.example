DIFFJURY_HOST=127.0.0.1
DIFFJURY_PORT=8080
DIFFJURY_DB_PATH=diffjury.db
DIFFJURY_MAX_DIFF_BYTES=1048576
DIFFJURY_MAX_STEPS=8
DIFFJURY_TIMEOUT_SECONDS=120

# Login is disabled by default for local use. Enable it before exposing the service.
DIFFJURY_AUTH_REQUIRED=false
DIFFJURY_AUTH_SECRET=
DIFFJURY_BOOTSTRAP_ADMIN_USERNAME=
DIFFJURY_BOOTSTRAP_ADMIN_PASSWORD=
DIFFJURY_DEFAULT_TENANT_ID=default
DIFFJURY_SESSION_TTL_SECONDS=3600

# LLM provider: local | deepseek | openrouter-deepseek-free | openrouter-free | custom
# local keeps the deterministic rule-only reviewer.
DIFFJURY_LLM_PROVIDER=local

DIFFJURY_ENABLED_AGENTS=lead,security,correctness-reliability,critic
DIFFJURY_AGENT_TOKEN_BUDGET=8000
DIFFJURY_AGENT_TIME_BUDGET_SECONDS=60
# Preflight semantic context budget. Keep input + output below the model window.
DIFFJURY_AGENT_CONTEXT_WINDOW_TOKENS=32768
DIFFJURY_AGENT_CONTEXT_INPUT_TOKENS=20000
DIFFJURY_CONTEXT_DIFF_TOKEN_BUDGET=12000
DIFFJURY_CONTEXT_OBSERVATION_TOKEN_BUDGET=4000
DIFFJURY_CONTEXT_RECENT_OBSERVATIONS=2
DIFFJURY_CONTEXT_MAP_CHUNK_TOKENS=3000
# Configure current provider pricing for non-zero cost accounting in reports.
DIFFJURY_LLM_INPUT_COST_PER_MILLION=0
DIFFJURY_LLM_OUTPUT_COST_PER_MILLION=0

# Official DeepSeek (paid API; model defaults to deepseek-v4-flash)
DIFFJURY_DEEPSEEK_API_KEY=

# OpenRouter free presets (API key required; low rate limits and availability may vary)
DIFFJURY_OPENROUTER_API_KEY=
DIFFJURY_OPENROUTER_SITE_URL=
DIFFJURY_OPENROUTER_APP_NAME=DiffJury

# Custom OpenAI-compatible Chat Completions endpoint (all three are required)
DIFFJURY_LLM_BASE_URL=
DIFFJURY_LLM_API_KEY=
DIFFJURY_LLM_MODEL=

# Knowledge governance (anti context rot)
DIFFJURY_KNOWLEDGE_ENABLED=true
# Per-call injection budgets and size caps
DIFFJURY_KNOWLEDGE_RULE_BUDGET_TOKENS=600
DIFFJURY_KNOWLEDGE_SKILL_BUDGET_TOKENS=3000
DIFFJURY_KNOWLEDGE_SKILL_BODY_CAP_TOKENS=1500
DIFFJURY_KNOWLEDGE_SKILL_CATALOG_LIMIT=8
DIFFJURY_KNOWLEDGE_RULE_MAX_TOKENS=60
# Admission: shortlist neighbours at this cosine, treat as duplicate above the second
DIFFJURY_KNOWLEDGE_SIMILARITY_THRESHOLD=0.3
DIFFJURY_KNOWLEDGE_DUPLICATE_THRESHOLD=0.85
# Outcome counters halve every N days; live rule tokens are capped per role
DIFFJURY_KNOWLEDGE_HALF_LIFE_DAYS=30
DIFFJURY_KNOWLEDGE_CAPACITY_TOKENS_PER_ROLE=2400
DIFFJURY_KNOWLEDGE_PIN_DISK_SKILLS=true
# Share of tasks that also see probation items
DIFFJURY_KNOWLEDGE_CANARY_PERCENT=20
# Background maintenance cadence and the live-token size that triggers LLM consolidation
DIFFJURY_KNOWLEDGE_MAINTAIN_EVERY_REVIEWS=50
DIFFJURY_KNOWLEDGE_DREAM_TOKEN_THRESHOLD=4000
# Replay release gate (disabled without a model); blank dataset = bundled pr_diff_100
DIFFJURY_KNOWLEDGE_GATE_DATASET=
DIFFJURY_KNOWLEDGE_GATE_SPLITS=validation
DIFFJURY_KNOWLEDGE_GATE_MAX_CASES=40
# Reject only a confident regression (CI upper bound < -margin) or a point drop above max-drop
DIFFJURY_KNOWLEDGE_GATE_MARGIN=0.02
DIFFJURY_KNOWLEDGE_GATE_MAX_DROP=0.10
DIFFJURY_KNOWLEDGE_GATE_WORKERS=4
# Long-term memory bounds
DIFFJURY_MEMORY_EPISODIC_TTL_DAYS=90
DIFFJURY_MEMORY_EPISODIC_CAP=300
DIFFJURY_MEMORY_SEMANTIC_CAP=500

# GitHub integration
DIFFJURY_GITHUB_WEBHOOK_SECRET=
DIFFJURY_GITHUB_TOKEN=
DIFFJURY_AUTO_POST_REVIEW=false
DIFFJURY_WEBHOOK_MAX_AGE_SECONDS=600

# Production persistence and queue. Leave blank for SQLite/in-process mode.
DIFFJURY_DATABASE_URL=
DIFFJURY_REDIS_URL=
DIFFJURY_ASYNC_WORKERS=2
DIFFJURY_QUEUE_MAX_ATTEMPTS=3
DIFFJURY_QUEUE_LEASE_SECONDS=60
DIFFJURY_SKILLS_DIR=skills

# Repair verification and observability
DIFFJURY_REPAIR_TEST_COMMAND=
DIFFJURY_REPAIR_VERIFY_TIMEOUT_SECONDS=120
DIFFJURY_MEMORY_ENABLED=true
DIFFJURY_MEMORY_RECALL_LIMIT=6
DIFFJURY_MEMORY_WORKING_TTL_SECONDS=86400
DIFFJURY_OTEL_ENDPOINT=
DIFFJURY_OTEL_SERVICE_NAME=diffjury
DIFFJURY_ALERT_FAILURE_RATE=0.20
DIFFJURY_ALERT_MIN_SAMPLES=10

# GitHub App (installation flow: /github/install, callback: /github/setup)
DIFFJURY_GITHUB_APP_ID=
DIFFJURY_GITHUB_APP_SLUG=
DIFFJURY_GITHUB_PRIVATE_KEY_PATH=
DIFFJURY_PUBLIC_BASE_URL=http://127.0.0.1:8080
